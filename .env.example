# Copy to .env and fill in. Never commit .env.

# --- Option 0 (free, no key): OpenCode Zen free models through the official OpenCode CLI ---
# Install OpenCode, run `opencode auth login` once, then:
# LLM_ENGINE=opencode
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# --- Option A: OpenCode Go subscription (https://opencode.ai/auth -> API keys) ---
# LLM_API_KEY=
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_FALLBACK_MODELS=deepseek-v4-pro
# (DeepSeek models need Settings > Privacy > Regions = Global in the OpenCode console)

# --- Option B: LLM via OpenRouter (https://openrouter.ai/keys) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# DeepSeek V4.1 Flash: ~$0.036 / $0.68 per 1M tokens (≈ $0.001 per campaign)
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Tried in order when the main model fails (e.g. no credit). ":free" models cost nothing.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
